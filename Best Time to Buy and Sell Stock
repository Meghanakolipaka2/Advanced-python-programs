class Solution {
    public int maxProfit(int[] prices) {
      int min_profit=prices[0];
      int max_profit=0;
      for(int price:prices){
        if(price<min_profit){
            min_profit=price;
        }
        int profit=price-min_profit;
      
        if(profit>max_profit){
            max_profit=profit;
         }
        }
        return max_profit;
    }
}
